#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufA { float a[]; };

// a = 1 everywhere: one storage buffer and no push constants at all. The
// length comes from the binding.
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < uint(a.length())) {
        a[idx] = 1.0;
    }
}
