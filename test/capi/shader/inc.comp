#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufA { float a[]; };

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

// a += 1 in place: one storage buffer, so two of these in one batch only give
// the right answer if the second sees what the first wrote.
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pc.n) {
        a[idx] = a[idx] + 1.0;
    }
}
