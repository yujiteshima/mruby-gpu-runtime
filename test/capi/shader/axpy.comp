#version 450

layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer BufA { float a[]; };
layout(set = 0, binding = 1) buffer BufB { float b[]; };
layout(set = 0, binding = 2) buffer BufC { float c[]; };

layout(push_constant) uniform PushConstants {
    uint n;
    float s;
} pc;

// c = a * s + b: three storage buffers and eight bytes of push constants.
void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx < pc.n) {
        c[idx] = a[idx] * pc.s + b[idx];
    }
}
